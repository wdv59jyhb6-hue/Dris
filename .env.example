# ============================================================
# DRIS — environment variables
# Copy this file to ".env" for local development, and add the
# SAME keys in the Vercel dashboard for production.
# NEVER commit the real .env file (it is in .gitignore).
# ============================================================

# --- Database (Neon) -----------------------------------------
# From the Neon dashboard: Project → Connection Details →
# copy the "Pooled connection" string. It looks like:
# postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DB?sslmode=require
DATABASE_URL="postgresql://user:password@your-neon-host/dbname?sslmode=require"

# --- Authentication ------------------------------------------
# A long random secret used to sign login tokens (JWT).
# Generate one with:  openssl rand -base64 48
# Use a DIFFERENT value in production than in development.
JWT_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# --- Seed password (optional) --------------------------------
# The password given to every demo account when you run
# `npm run db:seed`. Defaults to "dris2026" if unset.
SEED_PASSWORD="dris2026"
